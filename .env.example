# Configuração da Aplicação
PROJECT_NAME="Agente Autônomo de Notícias"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Segurança (Substitua por chaves seguras em ambiente de produção)
SECRET_KEY="sua-chave-secreta-jwt-de-producao-com-minimo-de-32-caracteres"
ENCRYPTION_KEY="sua-chave-fernet-base64-para-criptografia-de-tokens=="

# Modos de Operação: 'SIMULATION', 'ASSISTED', 'AUTONOMOUS'
AGENT_MODE="SIMULATION"
EMERGENCY_STOP=false

# Banco de Dados (SQLite local para dev ou PostgreSQL para produção)
DATABASE_URL="sqlite+aiosqlite:///./news_agent.db"
# DATABASE_URL="postgresql+asyncpg://usuario:senha@localhost:5432/agente_noticias"

# Cache e Filas
REDIS_URL="redis://localhost:6379/0"

# Armazenamento de Arquivos
STORAGE_DIR="./storage"
MEDIA_DIR="./storage/media"
VIDEO_DIR="./storage/videos"
AUDIO_DIR="./storage/audio"

# Provedores de Inteligência Artificial
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Credenciais de Plataformas de Publicação (YouTube OAuth 2.0)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# INSTAGRAM_ACCESS_TOKEN=""
# TIKTOK_CLIENT_KEY=""
# X_BEARER_TOKEN=""
# TELEGRAM_BOT_TOKEN=""

# Bancos de Vídeo Livres de Direitos Autorais (B-Roll ilustrativo; consulte as licenças de cada provedor)
# Obtenha gratuitamente em: https://www.pexels.com/api/ ou https://pixabay.com/api/docs/
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Módulo 2: Fábrica de Conteúdo Original (opt-in, sem gasto por padrão)
FACTORY_ENABLED=false
FACTORY_ADMIN_KEY=""
FACTORY_SCHEDULER_ENABLED=false
FACTORY_AUTO_PUBLISH=false
FACTORY_YOUTUBE_ACCOUNT_ID=""
FACTORY_YOUTUBE_PRIVACY=private
FACTORY_INTERVAL_SECONDS=60
FACTORY_DAILY_CALL_LIMIT=0
FACTORY_DAILY_BUDGET_MICROUSD=0
FACTORY_CALL_RESERVATION_MICROUSD=100000
FACTORY_MAX_ATTEMPTS=3
FACTORY_GEMINI_MODEL=gemini-2.5-flash
FACTORY_SOURCE_HOSTS=["www.nasa.gov","science.nasa.gov","www.esa.int","arxiv.org"]
FACTORY_SCORE_WEIGHTS={"curiosity":0.3,"evidence":0.4,"novelty":0.2,"evergreen":0.1}
