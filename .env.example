# Configuração da Aplicação
PROJECT_NAME="Agente Autônomo de Notícias"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Segurança (Substitua por chaves seguras em ambiente de produção)
SECRET_KEY="sua-chave-secreta-jwt-de-producao-com-minimo-de-32-caracteres"
ENCRYPTION_KEY="sua-chave-fernet-base64-para-criptografia-de-tokens=="

# Modos de Operação: 'SIMULATION', 'ASSISTED', 'AUTONOMOUS'
AGENT_MODE="SIMULATION"
EMERGENCY_STOP=false

# Banco de Dados (SQLite local para dev ou PostgreSQL para produção)
DATABASE_URL="sqlite+aiosqlite:///./news_agent.db"
# DATABASE_URL="postgresql+asyncpg://usuario:senha@localhost:5432/agente_noticias"

# Cache e Filas
REDIS_URL="redis://localhost:6379/0"

# Armazenamento de Arquivos
STORAGE_DIR="./storage"
MEDIA_DIR="./storage/media"
VIDEO_DIR="./storage/videos"
AUDIO_DIR="./storage/audio"

# Provedores de Inteligência Artificial
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Credenciais de Plataformas de Publicação (YouTube OAuth 2.0)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# INSTAGRAM_ACCESS_TOKEN=""
# TIKTOK_CLIENT_KEY=""
# X_BEARER_TOKEN=""
# TELEGRAM_BOT_TOKEN=""

# Bancos de Vídeo Livres de Direitos Autorais (B-Roll CC0 / Gratuitos para uso comercial)
# Obtenha gratuitamente em: https://www.pexels.com/api/ ou https://pixabay.com/api/docs/
PEXELS_API_KEY=""
PIXABAY_API_KEY=curl -H  "Authorization: YOUR_API_KEY "  \ 
  "https://api.pexels.com/v1/collections/featured?per_page=1"

